{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Coconut",
  "colors": {
    "primary": "#CC2500",
    "light": "#E63B00",
    "dark": "#A31E00",
    "background": {
      "light": "#F5F5F5",
      "dark": "#000000"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "decoration": "gradient"
  },
  "fonts": {
    "heading": {
      "family": "Plus Jakarta Sans",
      "weight": 600
    },
    "body": {
      "family": "Plus Jakarta Sans",
      "weight": 400
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "quickstart"
            ]
          },
          {
            "group": "MCP Tools",
            "pages": [
              "mcp-tools/overview",
              "mcp-tools/workspace-stats",
              "mcp-tools/creator-lookup",
              "mcp-tools/subscription-create",
              "mcp-tools/subscription-list",
              "mcp-tools/ingestion-trigger",
              "mcp-tools/ingestion-status",
              "mcp-tools/digest-list",
              "mcp-tools/digest-action",
              "mcp-tools/content-analyze",
              "mcp-tools/block-create",
              "mcp-tools/block-list"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "App",
          "href": "https://coconutapp.xyz",
          "icon": "browser"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/lobbyyy/coconut",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Pricing",
        "href": "https://coconutapp.xyz/pricing"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://coconutapp.xyz/sign-up"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/coconutdev",
      "github": "https://github.com/lobbyyy"
    }
  }
}
